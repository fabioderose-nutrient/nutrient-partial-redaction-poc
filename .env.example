# GdPicture.NET license key. Empty = evaluation mode (watermarked output).
GDPICTURE_LICENSE_KEY=
# Folder that contains eng.traineddata, for scanned pages. Empty = ./ocr next to the app, then the GdPicture.Resources NuGet package.
OCR_RESOURCES_PATH=
# Address the server listens on.
ASPNETCORE_URLS=http://localhost:5320
